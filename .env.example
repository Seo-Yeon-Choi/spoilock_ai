# Copy to .env, then use your existing key/model values.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# Original code default; use a model actually available to your account.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=8
PREFILTER_MODE=shadow
PREFILTER_SIM_THRESHOLD=
# First download: 0. Cached model only: 1.
HF_HUB_OFFLINE=0
