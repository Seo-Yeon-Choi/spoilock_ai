# Gemini API 키 (절대 커밋 금지)
GEMINI_API_KEY=
# Spring 의 SPOILER_ADMIN_TOKEN 과 같은 값
ADMIN_TOKEN=

# 기본 사건 DB 칸 (Spring 이 kb_version 을 보내면 그 값을 사용)
KB_VERSION=kb1

# 판정 사전 필터: off / shadow / on
PREFILTER_MODE=shadow
PREFILTER_SIM_THRESHOLD=

# 자막 + 영상 분석
INGEST_VIDEO_RESOLUTION=low
INGEST_VIDEO_BATCH_SLEEP=0

# 영상 음성 인식 (faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
